{
  "schema_version": "1.0.0",
  "repository": "atoussec-ctrl/SecOps",
  "target_branch": "main",
  "required_enforcement": "active",
  "merge_policy": {
    "require_pull_request": true,
    "required_approving_reviews": 1,
    "dismiss_stale_reviews": true,
    "require_code_owner_review": true,
    "require_last_push_approval": true,
    "require_conversation_resolution": true,
    "require_signed_commits": true,
    "require_merge_queue": true,
    "require_branch_up_to_date": true,
    "required_status_checks": [
      "Repository checks"
    ]
  },
  "push_policy": {
    "allow_force_pushes": false,
    "allow_deletions": false,
    "direct_push_to_main": false,
    "bypass_mode": "break-glass-only"
  },
  "release_prerequisites": {
    "ruleset_must_exist": true,
    "ruleset_must_be_active": true,
    "required_check_must_be_bound": true,
    "release_ref": "refs/heads/main",
    "privileged_workflow_is_not_merge_ready_until_live_governance_matches": true
  }
}
