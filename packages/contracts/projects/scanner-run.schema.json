{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-lab.invalid/contracts/projects/scanner-run.schema.json",
  "title": "External Scanner Run Receipt",
  "description": "Machine-readable receipt for one approved scanner capability. A process exit code alone is not a successful assessment; the orchestrator also verifies identity, project digest, status and output digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_version",
    "run_id",
    "assessment_id",
    "project_profile_digest",
    "capability",
    "adapter",
    "timing",
    "status",
    "exit_code",
    "output",
    "errors"
  ],
  "properties": {
    "run_version": { "$ref": "#/$defs/semantic_version" },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9]{4}-[0-9]{6}$"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^ASM-[0-9]{4}-[0-9]{4}$"
    },
    "project_profile_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability": {
      "enum": ["sast", "secrets", "sca", "iac", "workflow", "sbom"]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "tool", "tool_version", "artifact_digest"],
      "properties": {
        "adapter_id": {
          "type": "string",
          "pattern": "^adapter\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "tool_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at"],
      "properties": {
        "started_at": { "$ref": "#/$defs/timestamp" },
        "finished_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "status": {
      "enum": ["complete", "failed", "incomplete"]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "digest", "size_bytes", "findings_count"],
      "properties": {
        "format": { "enum": ["sarif", "json", "cyclonedx", "spdx"] },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "findings_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "$defs": {
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
