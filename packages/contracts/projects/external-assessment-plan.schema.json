{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-lab.invalid/contracts/projects/external-assessment-plan.schema.json",
  "title": "External Assessment Plan",
  "description": "Authorization and safety contract for static analysis of an external project. Version 1 intentionally cannot execute project scripts, install dependencies, mutate source, follow symlinks outside the project, or use the network during the scan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_version",
    "assessment_id",
    "project_profile_digest",
    "mode",
    "policy",
    "baseline",
    "capabilities",
    "advisory_data",
    "safety",
    "outputs"
  ],
  "properties": {
    "assessment_version": { "$ref": "#/$defs/semantic_version" },
    "assessment_id": {
      "type": "string",
      "pattern": "^ASM-[0-9]{4}-[0-9]{4}$"
    },
    "project_profile_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "const": "static-readonly"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,99}$"
        },
        "policy_version": { "$ref": "#/$defs/semantic_version" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["initial", "diff"] },
        "baseline_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inventory",
          "sast",
          "secrets",
          "sca",
          "iac",
          "workflow",
          "sbom"
        ]
      }
    },
    "advisory_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "snapshot_digest", "retrieved_at"],
      "properties": {
        "mode": { "const": "offline-snapshot" },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retrieved_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_access",
        "execute_project_scripts",
        "install_dependencies",
        "network_access",
        "follow_symlinks",
        "allow_outside_root",
        "max_duration_seconds"
      ],
      "properties": {
        "source_access": { "const": "read-only" },
        "execute_project_scripts": { "const": false },
        "install_dependencies": { "const": false },
        "network_access": { "const": "none" },
        "follow_symlinks": { "const": false },
        "allow_outside_root": { "const": false },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_root",
        "formats",
        "redact_secrets",
        "include_raw_secret_values",
        "retain_raw_evidence"
      ],
      "properties": {
        "workspace_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": ["json", "sarif", "cyclonedx", "spdx", "markdown", "html"]
          }
        },
        "redact_secrets": { "const": true },
        "include_raw_secret_values": { "const": false },
        "retain_raw_evidence": { "const": false }
      }
    }
  },
  "$defs": {
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
