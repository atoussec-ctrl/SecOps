{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-lab.invalid/contracts/ci/release-gate-receipt.schema.json",
  "title": "Release Gate Receipt",
  "description": "Deterministic release decision for one immutable artifact digest. A promote receipt is suitable for later in-toto/custom attestation; a block receipt remains local evidence and is never a promotion authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "artifact", "source", "evidence", "policy_version", "decision", "reasons"],
  "properties": {
    "receipt_version": { "const": "1.0.0" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "source": { "$ref": "#/$defs/source" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "policy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "decision": { "enum": ["promote", "block"] },
    "reasons": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9._-]{3,80}$" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string", "pattern": "^ghcr\\.io/atoussec-ctrl/[a-z0-9._/-]{1,180}$" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "workflow"],
      "properties": {
        "repository": { "const": "atoussec-ctrl/SecOps" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "workflow": { "type": "string", "minLength": 3, "maxLength": 160 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sbom_digest",
        "vulnerability_scan_digest",
        "malware_scan_digest",
        "signature_verified",
        "provenance_verified"
      ],
      "properties": {
        "sbom_digest": { "$ref": "#/$defs/sha256" },
        "vulnerability_scan_digest": { "$ref": "#/$defs/sha256" },
        "malware_scan_digest": { "$ref": "#/$defs/sha256" },
        "signature_verified": { "type": "boolean" },
        "provenance_verified": { "type": "boolean" }
      }
    }
  }
}
