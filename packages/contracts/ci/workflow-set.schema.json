{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-lab.invalid/contracts/ci/workflow-set.schema.json",
  "title": "Workflow Set",
  "description": "CI workflow descriptor. GitHub Actions workflow files are rendered from this document, so permissions, action pinning and shell injection are checked on a validated structure instead of on hand-written YAML. pull_request_target and raw workflow-expression strings have no representation; the few expressions needed by trusted release actions use a typed allowlisted object.",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_set_version", "workflows"],
  "properties": {
    "workflow_set_version": { "$ref": "#/$defs/semantic_version" },
    "workflows": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/workflow" }
    }
  },
  "$defs": {
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "permission_level": { "enum": ["read", "write", "none"] },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Only scopes the lab actually uses are representable. An unknown scope cannot be granted by accident.",
      "properties": {
        "contents": { "$ref": "#/$defs/permission_level" },
        "pull-requests": { "$ref": "#/$defs/permission_level" },
        "checks": { "$ref": "#/$defs/permission_level" },
        "id-token": { "$ref": "#/$defs/permission_level" },
        "security-events": { "$ref": "#/$defs/permission_level" },
        "packages": { "$ref": "#/$defs/permission_level" },
        "attestations": { "$ref": "#/$defs/permission_level" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "triggers", "permissions", "jobs"],
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 100 },
        "triggers": { "$ref": "#/$defs/triggers" },
        "permissions": { "$ref": "#/$defs/permissions" },
        "jobs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/job" }
        }
      }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "description": "pull_request_target is absent on purpose: it runs with repository secrets in the context of the base branch. merge_group is explicit so required CI also runs against merge-queue candidate commits.",
      "properties": {
        "pull_request": { "$ref": "#/$defs/branch_filter" },
        "merge_group": { "$ref": "#/$defs/branch_filter" },
        "push": { "$ref": "#/$defs/branch_filter" },
        "workflow_dispatch": { "const": true }
      }
    },
    "branch_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branches"],
      "properties": {
        "branches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,100}$" }
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "runs_on", "permissions", "timeout_minutes", "steps"],
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 100 },
        "runs_on": { "enum": ["ubuntu-latest", "ubuntu-24.04", "ubuntu-22.04"] },
        "permissions": { "$ref": "#/$defs/permissions" },
        "timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "input_value": {
      "type": ["string", "object"],
      "additionalProperties": false,
      "required": ["expression"],
      "properties": {
        "expression": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^(github\\.(actor|repository|sha|token)|secrets\\.GITHUB_TOKEN|steps\\.[A-Za-z_][A-Za-z0-9_-]*\\.outputs\\.[A-Za-z_][A-Za-z0-9_-]*)$",
          "description": "Expression body without ${{ }}. Only trusted immutable workflow metadata, the repository-scoped GITHUB_TOKEN, and outputs of named prior steps are representable. Event payload text and arbitrary secrets are intentionally absent."
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 100 },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$",
          "description": "Optional stable identifier used only for typed step-output references."
        },
        "kind": { "enum": ["action", "run"] },
        "action_ref": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]{1,40}$",
          "description": "Identifier of a version-manifest actions entry. A repository and tag are never written here, so an unpinned action cannot be referenced."
        },
        "with": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/input_value" }
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "A literal shell command. Raw workflow expressions remain forbidden so untrusted context cannot be interpolated into a shell."
        }
      }
    }
  }
}
