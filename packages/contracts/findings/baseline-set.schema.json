{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-lab.invalid/contracts/findings/baseline-set.schema.json",
  "title": "Reviewed Finding Baseline",
  "description": "Versioned, reviewable baseline used to classify findings as new, existing, regression or merely not observed. Absence does not itself mean remediated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline_version",
    "baseline_id",
    "project_id",
    "project_profile_digest",
    "commit_sha",
    "policy",
    "created_at",
    "findings"
  ],
  "properties": {
    "baseline_version": { "$ref": "#/$defs/semantic_version" },
    "baseline_id": {
      "type": "string",
      "pattern": "^BSL-[0-9]{4}-[0-9]{4}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,99}$"
    },
    "project_profile_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,99}$"
        },
        "policy_version": { "$ref": "#/$defs/semantic_version" }
      }
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "findings": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "state"],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state": { "enum": ["open", "verified"] }
        }
      }
    }
  },
  "$defs": {
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
