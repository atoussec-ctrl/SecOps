{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-lab.invalid/contracts/findings/finding-lifecycle.schema.json",
  "title": "Finding Lifecycle",
  "description": "The finding state machine as data rather than as a diagram (backlog E1-010). The Finding Hub is Python and the console is TypeScript, so the allowed transitions and the evidence each one demands are defined once here and both sides are tested against this table.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lifecycle_version", "initial_state", "states", "transitions"],
  "properties": {
    "lifecycle_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "initial_state": { "$ref": "#/$defs/state" },
    "states": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/state_definition" }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/transition" }
    }
  },
  "$defs": {
    "state": {
      "enum": [
        "new",
        "triaged",
        "confirmed",
        "false-positive",
        "remediating",
        "risk-accepted",
        "ready-for-retest",
        "verified",
        "reopened"
      ]
    },
    "role": {
      "enum": [
        "tester",
        "developer",
        "security-reviewer",
        "independent-reviewer",
        "risk-owner",
        "data-custodian"
      ]
    },
    "requirement": {
      "enum": [
        "scoped-asset",
        "affected-component",
        "reproducible-conditions",
        "redacted-evidence",
        "technical-impact",
        "root-cause",
        "confidence",
        "primary-cwe-or-reason",
        "remediation-direction",
        "reviewer-identity",
        "remediation-reference",
        "passing-pipeline",
        "independent-retest",
        "candidate-artifact-digest",
        "risk-owner",
        "future-expiry",
        "rationale"
      ]
    },
    "state_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "description", "terminal"],
      "properties": {
        "state": { "$ref": "#/$defs/state" },
        "description": { "type": "string", "minLength": 10, "maxLength": 300 },
        "terminal": {
          "type": "boolean",
          "description": "A finding never leaves a terminal state without new evidence, so no transition may originate from one."
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "role", "requires", "rationale"],
      "properties": {
        "from": { "$ref": "#/$defs/state" },
        "to": { "$ref": "#/$defs/state" },
        "role": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/role" }
        },
        "requires": {
          "type": "array",
          "maxItems": 17,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirement" }
        },
        "rationale": { "type": "string", "minLength": 10, "maxLength": 300 }
      }
    }
  }
}
