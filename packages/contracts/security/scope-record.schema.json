{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-lab.invalid/contracts/security/scope-record.schema.json",
  "title": "Scope Record",
  "description": "Authorization boundary for an engagement. A scope record must exist before any active test (docs/04-security/02-rules-of-engagement.md). Address and hostname patterns admit only loopback, private address space and reserved domains, so a public target cannot be expressed at all.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_version",
    "engagement_id",
    "purpose",
    "owner",
    "approval",
    "validity",
    "targets",
    "exclusions",
    "allowed_profiles",
    "budgets",
    "accounts",
    "data_handling",
    "stop"
  ],
  "properties": {
    "scope_version": {
      "$ref": "#/$defs/semantic_version"
    },
    "engagement_id": {
      "type": "string",
      "pattern": "^ENG-[0-9]{4}-[0-9]{4}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "contact"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approver",
        "approved_at",
        "reference",
        "scope_hash"
      ],
      "properties": {
        "approver": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "approved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scope_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/timestamp"
        },
        "end": {
          "$ref": "#/$defs/timestamp"
        },
        "timezone": {
          "type": "string",
          "pattern": "^(UTC|[A-Za-z]+/[A-Za-z_]+)$"
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applications",
        "hostnames",
        "ipv4",
        "cidrs",
        "urls",
        "ports",
        "api_versions"
      ],
      "properties": {
        "applications": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "hostnames": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lab_hostname"
          }
        },
        "ipv4": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/private_ipv4"
          }
        },
        "cidrs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/private_cidr"
          }
        },
        "urls": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lab_url"
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "api_versions": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          }
        }
      }
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostnames",
        "ipv4",
        "cidrs",
        "paths"
      ],
      "properties": {
        "hostnames": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lab_hostname"
          }
        },
        "ipv4": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/private_ipv4"
          }
        },
        "cidrs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/private_cidr"
          }
        },
        "paths": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/[^\\s]*$",
            "maxLength": 200
          }
        }
      }
    },
    "allowed_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "description": "Destructive tooling is not part of this product, so no destructive profile can be named here (docs/04-security/09-tool-safety-guardrails.md).",
      "items": {
        "enum": [
          "passive",
          "bounded-active"
        ]
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Every budget is bounded above so an excessive configuration value cannot be authorized.",
      "required": [
        "max_requests_per_second",
        "max_concurrency",
        "max_duration_seconds",
        "max_response_bytes",
        "max_test_records"
      ],
      "properties": {
        "max_requests_per_second": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "max_test_records": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "description": "Synthetic lab identities only. Real credentials are prohibited.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "role"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        }
      }
    },
    "data_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_data_only",
        "evidence_retention_days",
        "redaction_policy"
      ],
      "properties": {
        "synthetic_data_only": {
          "const": true,
          "description": "A scope cannot authorize work against real data."
        },
        "evidence_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "redaction_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contacts",
        "procedure"
      ],
      "properties": {
        "contacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "method"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        "procedure": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        }
      }
    }
  },
  "$defs": {
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "private_ipv4": {
      "type": "string",
      "description": "Loopback and RFC 1918 space only.",
      "pattern": "^(10\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|172\\.(1[6-9]|2[0-9]|3[01])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|192\\.168\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|127\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))$"
    },
    "private_cidr": {
      "type": "string",
      "description": "Loopback and RFC 1918 space only, prefix length 8 to 32.",
      "pattern": "^(10\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|172\\.(1[6-9]|2[0-9]|3[01])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|192\\.168\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|127\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))/(3[0-2]|[12][0-9]|[89])$"
    },
    "lab_hostname": {
      "type": "string",
      "maxLength": 253,
      "description": "localhost or a reserved RFC 2606 domain only.",
      "pattern": "^(localhost|([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+(test|example|invalid))$"
    },
    "lab_url": {
      "type": "string",
      "maxLength": 500,
      "description": "Scheme, host and optional port. The port range is the real one: a five-digit value above 65535 is not a port, and accepting it here would disagree with any client that parses it.",
      "pattern": "^https?://(localhost|([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+(test|example|invalid)|10\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|172\\.(1[6-9]|2[0-9]|3[01])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|192\\.168\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|127\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))(:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(/[^\\s?#]*)?$"
    }
  }
}
