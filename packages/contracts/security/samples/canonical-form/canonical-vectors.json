      "reason": "Floating point has no single textual form across languages."
    },
    {
      "name": "number outside the safe integer range",
      "value_json": "1e30",
      "reason": "Cannot round-trip exactly through a 64-bit float."
    },
    {
      "name": "overflowing exponent",
      "value_json": "1e999",
