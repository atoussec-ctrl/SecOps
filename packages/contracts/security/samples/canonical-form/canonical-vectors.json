    {
      "name": "object key containing a space",
      "value_json": "{\"two words\":1}",
      "reason": "Keys are restricted to letters, digits, underscore, dot and hyphen."
    },
    {
      "name": "unpaired surrogate in a string",
      "value_json": "\"\\ud800\"",
      "reason": "A lone surrogate has no UTF-8 encoding, so no two languages agree on its bytes."
